# Handle clean URLs for Next.js static export on Apache/cPanel
RewriteEngine On

# If requested file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Try adding .html if file exists with .html extension
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# Redirect 404 errors to Next.js 404 page
ErrorDocument 404 /404.html
